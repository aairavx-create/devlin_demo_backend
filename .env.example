# --- Postgres (e.g. Supabase) ---
# Tables are created automatically in the `devlin` schema on first request.
# SQLAlchemy-style URLs (postgresql+psycopg://...) are accepted too.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
# Optional: connection pool size (default 5)
# DATABASE_POOL_MAX=5

# --- Meta app (developers.facebook.com > your app > App settings > Basic) ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Must be added to "Valid OAuth Redirect URIs" in Facebook Login settings
META_REDIRECT_URI=http://localhost:4000/api/auth/facebook/callback
# Optional: Facebook Login for Business configuration ID. When set, it is used instead of META_SCOPES.
META_LOGIN_CONFIG_ID=
META_SCOPES=pages_show_list,pages_read_engagement,pages_read_user_content,pages_manage_metadata,pages_manage_ads,read_insights,instagram_basic,instagram_manage_insights,ads_read,leads_retrieval,business_management,ads_management
# Any random string; paste the same value into the Webhooks "Verify token" field in your Meta app
META_WEBHOOK_VERIFY_TOKEN=

# --- Security ---
# 64 hex chars (32 bytes). Used to encrypt access tokens at rest. Never change it after tokens are stored.
TOKEN_ENCRYPTION_KEY=
# Shared key the dashboard sends as the x-api-key header
AGENT_API_KEY=

# --- Dashboard ---
DASHBOARD_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
